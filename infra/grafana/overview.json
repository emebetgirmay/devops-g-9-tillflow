{
  "uid": "tillflow-overview",
  "title": "TillFlow overview",
  "description": "Uptime, SLO, budget remaining and burn rate per service (ADR 0010). Generated by infra/grafana/build.py.",
  "tags": [
    "tillflow",
    "devops-g9",
    "g3"
  ],
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "CloudWatch",
        "type": "datasource",
        "query": "cloudwatch",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "lb",
        "label": "Load balancer",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "LoadBalancer",
          "refId": "var-lb"
        },
        "definition": "dimension_values(eu-north-1,AWS/ApplicationELB,RequestCount,LoadBalancer)",
        "regex": "/devops-g9-alb/",
        "refresh": 1,
        "hide": 2,
        "sort": 1
      },
      {
        "name": "pos_tg",
        "label": "POS target group",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "TargetGroup",
          "refId": "var-pos_tg"
        },
        "definition": "dimension_values(eu-north-1,AWS/ApplicationELB,RequestCount,TargetGroup)",
        "regex": "/devops-g9-pos//",
        "refresh": 1,
        "hide": 2,
        "sort": 1
      },
      {
        "name": "payments_tg",
        "label": "Payments target group",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "TargetGroup",
          "refId": "var-payments_tg"
        },
        "definition": "dimension_values(eu-north-1,AWS/ApplicationELB,RequestCount,TargetGroup)",
        "regex": "/devops-g9-payments//",
        "refresh": 1,
        "hide": 2,
        "sort": 1
      }
    ]
  },
