{
  "uid": "tillflow-payments",
  "title": "TillFlow Payments",
  "description": "Payments RED, saturation and money-path signals (ADR 0009). Generated by infra/grafana/build.py.",
  "tags": [
    "tillflow",
    "devops-g9",
    "g3"
  ],
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "CloudWatch",
        "type": "datasource",
        "query": "cloudwatch",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "lb",
        "label": "Load balancer",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "LoadBalancer",
          "refId": "var-lb"
        },
        "definition": "dimension_values(eu-north-1,AWS/ApplicationELB,RequestCount,LoadBalancer)",
        "regex": "/devops-g9-alb/",
        "refresh": 1,
        "hide": 2,
        "sort": 1
      },
      {
        "name": "pos_tg",
        "label": "POS target group",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "TargetGroup",
          "refId": "var-pos_tg"
        },
        "definition": "dimension_values(eu-north-1,AWS/ApplicationELB,RequestCount,TargetGroup)",
        "regex": "/devops-g9-pos//",
        "refresh": 1,
        "hide": 2,
        "sort": 1
      },
      {
        "name": "payments_tg",
        "label": "Payments target group",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "TargetGroup",
          "refId": "var-payments_tg"
        },
        "definition": "dimension_values(eu-north-1,AWS/ApplicationELB,RequestCount,TargetGroup)",
        "regex": "/devops-g9-payments//",
        "refresh": 1,
        "hide": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Payments RED at the ALB",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per 5 min",
      "description": "",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "r",
          "id": "r",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": {
            "LoadBalancer": "$lb",
            "TargetGroup": "$payments_tg"
          },
          "matchExact": true,
          "statistic": "Sum",
          "period": "300",
          "expression": "",
          "label": "requests",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "never",
            "axisSoftMin": 0
          },
          "noValue": "no data yet"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors per 5 min",
      "description": "",
