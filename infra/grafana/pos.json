      "title": "POS app metrics (GET /metrics, scraped by ADOT)",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Requests by route and status",
      "description": "",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "a",
          "id": "a",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "region": "eu-north-1",
          "expression": "SEARCH('{TillFlow,OTelLib,route,status_class} MetricName=\"pos_http_requests_total\"', 'Sum', 300)",
          "period": "",
          "label": "${PROP('Dim.route')} ${PROP('Dim.status_class')}",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "never",
            "axisSoftMin": 0,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "noValue": "no data yet"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
