{
  "uid": "tillflow-pos",
  "title": "TillFlow POS",
  "description": "POS RED, saturation and business signals. Generated by infra/grafana/build.py.",
  "tags": [
    "tillflow",
    "devops-g9",
    "g3"
  ],
  "timezone": "utc",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "CloudWatch",
        "type": "datasource",
        "query": "cloudwatch",
        "refresh": 1,
        "hide": 0
      },
      {
        "name": "lb",
        "label": "Load balancer",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "LoadBalancer",
          "refId": "var-lb"
        },
        "definition": "dimension_values(eu-north-1,AWS/ApplicationELB,RequestCount,LoadBalancer)",
        "regex": "/devops-g9-alb/",
        "refresh": 1,
        "hide": 2,
        "sort": 1
      },
      {
        "name": "pos_tg",
        "label": "POS target group",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "TargetGroup",
          "refId": "var-pos_tg"
        },
        "definition": "dimension_values(eu-north-1,AWS/ApplicationELB,RequestCount,TargetGroup)",
        "regex": "/devops-g9-pos//",
        "refresh": 1,
        "hide": 2,
        "sort": 1
      },
      {
        "name": "payments_tg",
        "label": "Payments target group",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "query": {
          "queryType": "dimensionValues",
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensionKey": "TargetGroup",
          "refId": "var-payments_tg"
        },
        "definition": "dimension_values(eu-north-1,AWS/ApplicationELB,RequestCount,TargetGroup)",
        "regex": "/devops-g9-payments//",
        "refresh": 1,
        "hide": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "POS RED at the ALB",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per 5 min",
      "description": "",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "r",
          "id": "r",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "RequestCount",
          "dimensions": {
            "LoadBalancer": "$lb",
            "TargetGroup": "$pos_tg"
          },
          "matchExact": true,
          "statistic": "Sum",
          "period": "300",
          "expression": "",
          "label": "requests",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "never",
            "axisSoftMin": 0
          },
          "noValue": "no data yet"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors per 5 min",
      "description": "",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "e5",
          "id": "e5",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_5XX_Count",
          "dimensions": {
            "LoadBalancer": "$lb",
            "TargetGroup": "$pos_tg"
          },
          "matchExact": true,
          "statistic": "Sum",
          "period": "300",
          "expression": "",
          "label": "5xx",
          "hide": false
        },
        {
          "refId": "e4",
          "id": "e4",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HTTPCode_Target_4XX_Count",
          "dimensions": {
            "LoadBalancer": "$lb",
            "TargetGroup": "$pos_tg"
          },
          "matchExact": true,
          "statistic": "Sum",
          "period": "300",
          "expression": "",
          "label": "4xx",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "never",
            "axisSoftMin": 0
          },
          "noValue": "no data yet"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency (target response time)",
      "description": "Orange line: the SLO doc's p95 threshold, 500 ms.",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "p95",
          "id": "p95",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "TargetResponseTime",
          "dimensions": {
            "LoadBalancer": "$lb",
            "TargetGroup": "$pos_tg"
          },
          "matchExact": true,
          "statistic": "p95",
          "period": "300",
          "expression": "",
          "label": "p95",
          "hide": false
        },
        {
          "refId": "p50",
          "id": "p50",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "TargetResponseTime",
          "dimensions": {
            "LoadBalancer": "$lb",
            "TargetGroup": "$pos_tg"
          },
          "matchExact": true,
          "statistic": "p50",
          "period": "300",
          "expression": "",
          "label": "p50",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "never",
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "noValue": "no data yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "row",
      "title": "POS saturation",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU and memory (%)",
      "description": "Orange line: the ecs-cpu-high alarm and the target-tracking line (70%).",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "cpu",
          "id": "cpu",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "eu-north-1",
          "namespace": "AWS/ECS",
          "metricName": "CPUUtilization",
          "dimensions": {
            "ClusterName": "devops-g9",
            "ServiceName": "devops-g9-pos"
          },
          "matchExact": true,
          "statistic": "Average",
          "period": "",
          "expression": "",
          "label": "CPU",
          "hide": false
        },
        {
          "refId": "mem",
          "id": "mem",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "eu-north-1",
          "namespace": "AWS/ECS",
          "metricName": "MemoryUtilization",
          "dimensions": {
            "ClusterName": "devops-g9",
            "ServiceName": "devops-g9-pos"
          },
          "matchExact": true,
          "statistic": "Average",
          "period": "",
          "expression": "",
          "label": "memory",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "never",
            "axisSoftMin": 0,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "noValue": "no data yet",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Healthy targets",
      "description": "",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "h",
          "id": "h",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "HealthyHostCount",
          "dimensions": {
            "LoadBalancer": "$lb",
            "TargetGroup": "$pos_tg"
          },
          "matchExact": true,
          "statistic": "Minimum",
          "period": "60",
          "expression": "",
          "label": "healthy",
          "hide": false
        },
        {
          "refId": "u",
          "id": "u",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 0,
          "region": "eu-north-1",
          "namespace": "AWS/ApplicationELB",
          "metricName": "UnHealthyHostCount",
          "dimensions": {
            "LoadBalancer": "$lb",
            "TargetGroup": "$pos_tg"
          },
          "matchExact": true,
          "statistic": "Maximum",
          "period": "60",
          "expression": "",
          "label": "unhealthy",
          "hide": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "never",
            "axisSoftMin": 0
          },
          "noValue": "no data yet"
